  "target_column": "target",
  "id_column": "id",
  "split": {
    "strategy": "stratified",
    "validation_fraction": 0.2,
    "group_column": null,
    "time_column": null
  },
  "features": {
    "numeric_columns": [],
    "categorical_columns": []
  },
  "model": {
    "name": "logistic_regression"
  },
  "metric": {
